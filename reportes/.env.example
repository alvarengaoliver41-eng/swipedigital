# Copiar a .env (local) o cargar en Vercel → Settings → Environment Variables.
# Nunca subir los valores reales a GitHub.

# Meta: clave del usuario del sistema de la agencia (permiso ads_read)
META_ACCESS_TOKEN=
META_API_VERSION=v26.0

# Supabase: Project Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
